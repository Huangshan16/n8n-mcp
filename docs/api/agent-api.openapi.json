{
  "openapi": "3.0.3",
  "info": {
    "title": "n8n-mcp Agent Backend API",
    "version": "1.0.0",
    "description": "Agent backend HTTP API for local frontend development."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3005"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/chat": {
      "post": {
        "summary": "Chat with agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponseEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/agent/confirm": {
      "post": {
        "summary": "Confirm summary / advance phase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfirmRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AgentResponseEnvelope" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/agent/confirm-build": {
      "post": {
        "summary": "Confirm build (alias of confirm)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfirmRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AgentResponseEnvelope" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/agent/reset-session": {
      "post": {
        "summary": "Reset session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfirmRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  },
                  "required": ["success"]
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/workflow/create": {
      "post": {
        "summary": "Create workflow in n8n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WorkflowCreateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created workflow",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkflowCreateResult" }
              }
            }
          },
          "400": {
            "description": "Bad request or missing n8n config",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "sessionId": { "type": "string" }
        },
        "required": ["message"]
      },
      "ConfirmRequest": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" }
        },
        "required": ["sessionId"]
      },
      "AgentResponseEnvelope": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "response": { "$ref": "#/components/schemas/AgentResponse" }
        },
        "required": ["sessionId", "response"]
      },
      "AgentResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["guidance", "summary_ready", "workflow_ready", "error"]
          },
          "message": { "type": "string" },
          "blueprint": { "$ref": "#/components/schemas/WorkflowBlueprint" },
          "workflow": { "$ref": "#/components/schemas/WorkflowDefinition" },
          "reasoning": { "type": "string" },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["type", "message"]
      },
      "WorkflowBlueprint": {
        "type": "object",
        "properties": {
          "intentSummary": { "type": "string" },
          "triggers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BlueprintEntry" }
          },
          "logic": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BlueprintEntry" }
          },
          "executors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BlueprintEntry" }
          },
          "missingFields": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "BlueprintEntry": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "WorkflowDefinition": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "connections": {
            "type": "object",
            "additionalProperties": true
          },
          "settings": {
            "type": "object",
            "additionalProperties": true
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["name", "nodes", "connections"]
      },
      "WorkflowCreateRequest": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "workflow": { "$ref": "#/components/schemas/WorkflowDefinition" }
            },
            "required": ["workflow"]
          },
          {
            "type": "object",
            "properties": {
              "sessionId": { "type": "string" }
            },
            "required": ["sessionId"]
          }
        ]
      },
      "WorkflowCreateResult": {
        "type": "object",
        "properties": {
          "workflowId": { "type": "string" },
          "workflowName": { "type": "string" },
          "workflowUrl": { "type": "string" }
        },
        "required": ["workflowId", "workflowName", "workflowUrl"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        },
        "required": ["error"]
      }
    }
  }
}
